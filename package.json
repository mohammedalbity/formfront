{
  "name": "formio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "test:auth": "echo 'Testing Laravel Sanctum authentication...' && curl -X GET https://formend.fikra-ye.app/sanctum/csrf-cookie -c cookies.txt && curl -X POST https://formend.fikra-ye.app/api/login -H 'Content-Type: application/json' -b cookies.txt"
  },
  "dependencies": {
    "@formio/js": "^5.2.2",
    "axios": "^1.11.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.21",
    "vue-i18n": "^11.1.12",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.0.1",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@tailwindcss/typography": "^0.5.16",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.18.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.35.0",
    "eslint-plugin-vue": "~10.3.0",
    "jiti": "^2.5.1",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.6",
    "prettier": "3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "vite": "^6.3.6",
    "vite-plugin-vue-devtools": "^8.0.1",
    "vue-tsc": "^3.0.6"
  }
}